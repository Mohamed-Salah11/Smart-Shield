# ============================================================
# Smart Shield — .gitignore  (production GitHub repo)
# ============================================================
# Source repo on GitHub keeps tests/, scripts/, docs/. The release
# archive built by scripts/build_release.sh excludes runtime state
# (tests, logs, *.db, __pycache__) on its own — see
# tools/build_release.py EXCLUDE_PATTERNS for the authoritative list.

# ── Python bytecode / cache ──────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*$py.class

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version
.envrc

# ── Environment / secrets (KEEP TEMPLATES) ───────────────────
# .env contains real keys; .env.example is shipped as the template.
.env
.env.*
*.env
!.env.example

# Runtime config (operator data); the example variant is shipped.
config.json
!config.example.json

# ── Runtime data / logs / uploads ────────────────────────────
*.log
logs/
instance/
flask_session/
static/uploads/
uploads/
backups/
*.pid

# SQLite databases (DB + WAL/SHM sidecars). data.db is the
# canonical Smart Shield DB; *.db catches the per-test fixtures
# and the _v_hn.db quarantine that has leaked into past archives.
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
data.db
_v_hn.db*

# ── Secrets and credentials ──────────────────────────────────
# master.key is the AES-GCM root for app/secret_store.py.
master.key
*.key
*.psk
*.p8
ipsec.secrets
*.ovpn
# Allow filenames ending in .example.* (e.g. ssl.key.example) so
# packaging examples stay tracked.
!*.example.*

# ── TLS / PKI artifacts ──────────────────────────────────────
*.pem
*.crt
*.csr
*.p12
*.pfx
!*.example.*

# ── Tests, scripts, docs — TRACKED on GitHub ────────────────
# Previous ignore blocked these wholesale; that broke CI and hid
# scripts/build_release.sh from version control. The release
# builder excludes tests/ from the appliance archive on its own
# (tools/build_release.py EXCLUDE_PATTERNS), so the repo can
# safely track them here. Only the test runtime artefacts below
# are ignored.
test_*.db
*.test.db
conftest.py.bak

# ── Test / coverage / linting cache ─────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/
.hypothesis/
.tox/
.nox/
pip-log.txt

# ── Build / distribution artifacts ───────────────────────────
build/
dist/
*.egg
*.egg-info/
pip-wheel-metadata/
# Build-time metadata files emitted by scripts/build_release.sh
# directly into the archive — never check in to the working tree.
RELEASE_MANIFEST.json

# ── Rust build artifacts (cryptography wheel) ────────────────
target/
Cargo.lock

# ── Documentation build output (keep docs/ sources tracked) ─
docs/_build/
docs/_autosummary/

# ── Editor / OS files ────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Editor swap / backup files ───────────────────────────────
*.swp
*.swo
*~
*.bak
*.orig
*.tmp
*.temp

# ── Process output ───────────────────────────────────────────
nohup.out

# ── Node / frontend tooling (if a frontend ever lands) ──────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Claude Code project state (per-machine; never publish) ──
.claude/

# ── Local working notes (personal scratch — keep out of GH) ─
paper.bib
edits.txt
paths.txt
project steps.txt
integrations_steps_source.txt
integrations steps of the vpns ids ips and every other service included in the project.pdf
smart-shield-transfer-*.tar.gz
_split*.py
_*urlmap*.json

# ── Generic archive outputs (release tarballs live under dist/) ─
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ── VM / disk images ─────────────────────────────────────────
*.vmdk
*.vdi
*.ova
*.qcow2
*.iso

# ── Windows-only helper scripts (FreeBSD target) ────────────
*.bat
*.cmd
*.ps1
