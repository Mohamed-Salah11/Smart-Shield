# ============================================================
# Smart Shield — .gitignore
# ============================================================

# ── Python bytecode / cache ──────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
*.pyi

# ── Virtual environments ─────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets (keep templates) ───────────────────
.env
.env.*
*.env
!.env.example
config.json

# ── Runtime data / logs / uploads ────────────────────────────
*.log
logs/
instance/
flask_session/
static/uploads/
uploads/
backups/
*.pid
*.sqlite
*.sqlite3
*.db
data.db

# ── Secrets and credentials ──────────────────────────────────
master.key
*.key
*.psk
*.p8
ipsec.secrets
*.ovpn
!*.example.*

# ── TLS / PKI artifacts (keep .example variants) ─────────────
*.pem
*.crt
*.csr
*.p12
*.pfx
!*.example.*

# ── Tests directory ──────────────────────────────────────────
tests/

# ── Test / coverage / linting cache ─────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.cache/
.hypothesis/
pip-log.txt

# ── Build / distribution artifacts ───────────────────────────
build/
dist/
*.egg-info/
pip-wheel-metadata/

# ── Rust build artifacts (used by cryptography wheel) ────────
target/
Cargo.lock

# ── Documentation build ──────────────────────────────────────
docs/_build/
docs/_autosummary/

# ── Editor / OS files ────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Editor swap / backup files ───────────────────────────────
*.swp
*.swo
*~
*.bak
*.orig
*.tmp
*.temp

# ── Process output ───────────────────────────────────────────
nohup.out

# ── Claude Code project state (not needed on FreeBSD deployment) ──
.claude/

# ── Non-professional / working notes ─────────────────────────
Testing.md
TODO_FULL_LIVE_APPLIANCE.md
docs/
paper.bib

# ── Local / generated project artifacts ──────────────────────
edits.txt
paths.txt
project steps.txt
integrations_steps_source.txt
integrations steps of the vpns ids ips and every other service included in the project.pdf
smart-shield-transfer-*.tar.gz

# ── Generic archive outputs ───────────────────────────────────
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# ── VM / disk images ─────────────────────────────────────────
*.vmdk
*.vdi
*.ova
*.qcow2
*.iso

# ── Windows-only scripts (not needed on FreeBSD) ─────────────
*.bat
*.cmd
*.ps1
