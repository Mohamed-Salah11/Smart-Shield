APP_ENV=production
SECRET_KEY=replace-this-with-a-long-random-secret
FLASK_DEBUG=0

# Optional explicit env-file path. The app loads this file before any local
# .env (override=False on the second load). Defaults to the FreeBSD appliance
# path below. Override for testing/development checkouts on other hosts.
SMARTSHIELD_ENV_FILE=/usr/local/etc/smartshield/smartshield.env

SMARTSHIELD_DB_PATH=/var/db/smartshield/data.db
SMARTSHIELD_CONFIG_PATH=/usr/local/etc/smartshield/config.json
SMARTSHIELD_UPLOAD_DIR=/var/db/smartshield/uploads/profile_pictures
SMARTSHIELD_AUDIT_LOG_PATH=/var/log/smartshield/audit.log
SMARTSHIELD_APP_LOG_PATH=/var/log/smartshield/app.log
SMARTSHIELD_MASTER_KEY_PATH=/usr/local/etc/smartshield/master.key
SMARTSHIELD_ENABLE_NETWORK_APPLY=0
SMARTSHIELD_NETWORK_DRY_RUN=0

# Content-Security-Policy strict mode (Fv11 review §P1-02).
#  1 = drop 'unsafe-inline'; inline blocks must carry a CSP nonce.
#  0 = allow 'unsafe-inline' (transitional).
# Default when unset: strict in production (FLASK_DEBUG=0), relaxed in debug.
SS_STRICT_CSP=1

# Master key for reversible secret encryption (AES-256-GCM).
# Generate with: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# If unset, a key is auto-generated and stored at /usr/local/etc/smartshield/master.key (FreeBSD)
# or %LOCALAPPDATA%/SmartShield/master.key (Windows dev).
# SMARTSHIELD_MASTER_KEY=

# ---------------------------------------------------------------------------
# Abuse.ch threat intelligence (URLhaus / MalwareBazaar / ThreatFox)
# ---------------------------------------------------------------------------
# Required to use the abuse.ch API. Obtain your personal Auth-Key at:
#   https://abuse.ch/
# Never commit the real key — store it here locally or in your server's
# secret manager (e.g. Vault, AWS Secrets Manager, FreeBSD rcvar).
ABUSECH_AUTH_KEY=

# Set to "0" to enable live API lookups (default "1" = dry-run, log-only).
ABUSECH_DRY_RUN=1

# ---------------------------------------------------------------------------
# SmartShield AI Chatbot (Groq)
# ---------------------------------------------------------------------------
# Get a free API key at https://console.groq.com/keys
# Also configurable via Admin → Settings → SmartShield AI after first boot.
GROQ_API_KEY=

# Optional Google Programmable Search keys — enable the chatbot's live web
# search tool. Leave blank to disable web search. Both are also configurable
# via Admin → Settings → SmartShield AI after first boot.
# Create at https://programmablesearchengine.google.com/ and
# https://console.cloud.google.com/apis/credentials
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# ---------------------------------------------------------------------------
# Bootstrap admin account (first run only)
# ---------------------------------------------------------------------------
# If set, an initial superuser is created on first startup when no users
# exist. Leave blank to instead create the admin through the setup wizard
# (Step 3 — Admin password) on first web access.
BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
