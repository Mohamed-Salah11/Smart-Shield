#!/bin/sh
# =============================================================================
# smartshieldctl — Smart Shield operator control tool for FreeBSD
# =============================================================================
# Install: install -m 0555 smartshieldctl /usr/local/sbin/smartshieldctl
# Usage:   smartshieldctl <command> [args]
# =============================================================================
set -eu

# ── Config ────────────────────────────────────────────────────────────────────
SERVICE_NAME="${SMARTSHIELD_SERVICE_NAME:-smart_shield}"
APP_ROOT="${SMARTSHIELD_APP_ROOT:-/usr/local/share/smart-shield}"
ENV_FILE="${SMARTSHIELD_ENV_FILE:-/usr/local/etc/smart-shield/smart-shield.env}"
DEFAULT_DB="${APP_ROOT}/data.db"
LOG_FILE="/var/log/smart-shield/app.log"
AUDIT_LOG="/var/log/smart-shield/audit.log"
ACCESS_LOG="/var/log/smart-shield/access.log"
WEB_BIND="${SMARTSHIELD_BIND:-127.0.0.1:5000}"

# ── Helpers ───────────────────────────────────────────────────────────────────
_load_env() {
    [ -f "${ENV_FILE}" ] && . "${ENV_FILE}" || true
}

_db() {
    _load_env
    echo "${SMARTSHIELD_DB_PATH:-${DEFAULT_DB}}"
}

_need_sqlite() {
    command -v sqlite3 >/dev/null 2>&1 || { echo "error: sqlite3 not found"; exit 1; }
}

_need_python() {
    command -v python3 >/dev/null 2>&1 || { echo "error: python3 not found"; exit 1; }
}

_need_root() {
    [ "$(id -u)" -eq 0 ] || { echo "error: this command requires root"; exit 1; }
}

_sql() {
    _need_sqlite
    sqlite3 "$(_db)" "$1"
}

_validate_cidr() {
    _need_python
    python3 - "$1" <<'PY'
import ipaddress, sys
try:
    i = ipaddress.ip_interface(sys.argv[1])
    print(i.with_prefixlen)
except Exception:
    raise SystemExit(1)
PY
}

_validate_ip() {
    _need_python
    python3 - "$1" <<'PY'
import ipaddress, sys
try:
    print(str(ipaddress.ip_address(sys.argv[1])))
except Exception:
    raise SystemExit(1)
PY
}

_resolve_port() {
    # Returns the physical port (e.g. em0) assigned to WAN or LAN
    itype="$1"
    raw="$(_sql "SELECT network_port FROM interface_assignments WHERE interface_type='${itype}' LIMIT 1;")"
    echo "${raw}" | awk '{print $1}' | tr -cd 'A-Za-z0-9_.:-'
}

_color() {
    # _color <code> <text>
    printf "\033[%sm%s\033[0m" "$1" "$2"
}

_ok()   { printf "  [ $(_color '0;32' 'OK')     ] %s\n" "$1"; }
_warn() { printf "  [ $(_color '0;33' 'WARN')   ] %s\n" "$1"; }
_err()  { printf "  [ $(_color '0;31' 'ERROR')  ] %s\n" "$1"; }
_info() { printf "  [ $(_color '0;34' 'INFO')   ] %s\n" "$1"; }

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_start()   { _need_root; service "${SERVICE_NAME}" start; }
cmd_stop()    { _need_root; service "${SERVICE_NAME}" stop; }
cmd_restart() { _need_root; service "${SERVICE_NAME}" restart; }
cmd_status()  { service "${SERVICE_NAME}" status; }
cmd_enable()  { _need_root; sysrc "${SERVICE_NAME}_enable=YES"; echo "Enabled at boot."; }
cmd_disable() { _need_root; sysrc "${SERVICE_NAME}_enable=NO";  echo "Disabled at boot."; }

cmd_logs() {
    lines="${1:-100}"
    tail -n "${lines}" "${LOG_FILE}" 2>/dev/null || echo "Log not found: ${LOG_FILE}"
}

cmd_audit() {
    lines="${1:-100}"
    tail -n "${lines}" "${AUDIT_LOG}" 2>/dev/null || echo "Log not found: ${AUDIT_LOG}"
}

cmd_access() {
    lines="${1:-50}"
    tail -n "${lines}" "${ACCESS_LOG}" 2>/dev/null || echo "Log not found: ${ACCESS_LOG}"
}

cmd_health() {
    url="http://${WEB_BIND}/login"
    if fetch -qo /dev/null "${url}" 2>/dev/null; then
        _ok "Web UI reachable at ${url}"
    elif curl -fsS -o /dev/null "${url}" 2>/dev/null; then
        _ok "Web UI reachable at ${url}"
    else
        _err "Web UI NOT reachable at ${url}"
        exit 1
    fi
}

cmd_iface_show() {
    itype="$(echo "${1:-LAN}" | tr '[:lower:]' '[:upper:]')"
    case "${itype}" in LAN) tbl="lan_config" ;; WAN) tbl="wan_config" ;; *)
        echo "error: expected LAN or WAN"; exit 1 ;; esac
    _need_sqlite
    row="$(_sql "SELECT COALESCE(assigned_port,''), COALESCE(ipv4_config_type,''), COALESCE(ipv4_address,''), COALESCE(ipv4_upstream_gateway,'') FROM ${tbl} WHERE id=1;")"
    port="$(echo "${row}" | cut -d'|' -f1)"
    mode="$(echo "${row}" | cut -d'|' -f2)"
    addr="$(echo "${row}" | cut -d'|' -f3)"
    gw="$(echo "${row}" | cut -d'|' -f4)"
    phys="$(_resolve_port "${itype}" || true)"
    echo "Interface     : ${itype}"
    echo "Physical Port : ${phys:-${port:-<unassigned>}}"
    echo "IPv4 Mode     : ${mode:-unknown}"
    echo "IPv4 Address  : ${addr:-<empty>}"
    echo "IPv4 Gateway  : ${gw:-<empty>}"
    # Live state from ifconfig
    if [ -n "${phys}" ] && command -v ifconfig >/dev/null 2>&1; then
        live="$(ifconfig "${phys}" 2>/dev/null | grep 'inet ' | awk '{print $2"/"$4}' | head -1)"
        echo "Live IP       : ${live:-<none>}"
        state="$(ifconfig "${phys}" 2>/dev/null | grep -c 'RUNNING' || true)"
        echo "Link          : $([ "${state}" -gt 0 ] && echo UP || echo DOWN)"
    fi
}

cmd_iface_set() {
    itype="$(echo "${1:-}" | tr '[:lower:]' '[:upper:]')"
    mode="$(echo "${2:-}" | tr '[:upper:]' '[:lower:]')"
    [ -z "${itype}" ] || [ -z "${mode}" ] && { _usage; exit 1; }
    shift 2 || true
    case "${itype}" in LAN) tbl="lan_config" ;; WAN) tbl="wan_config" ;; *)
        echo "error: expected LAN or WAN"; exit 1 ;; esac
    _need_sqlite
    apply_now=0; cidr=""; gateway=""
    for a in "$@"; do
        case "${a}" in --apply) apply_now=1 ;;
            *) [ -z "${cidr}" ] && cidr="${a}" || gateway="${a}" ;;
        esac
    done
    _sql "INSERT OR IGNORE INTO ${tbl} (id) VALUES (1);"
    case "${mode}" in
        dhcp)
            _sql "UPDATE ${tbl} SET ipv4_config_type='dhcp',ipv4_address='',ipv4_upstream_gateway='' WHERE id=1;"
            echo "${itype} configured as DHCP."
            if [ "${apply_now}" = "1" ]; then
                phys="$(_resolve_port "${itype}" || true)"
                [ -n "${phys}" ] && { ifconfig "${phys}" up; dhclient "${phys}"; echo "DHCP lease requested on ${phys}."; } \
                                 || echo "No physical port assigned — DB updated only."
            fi
            ;;
        static)
            [ -z "${cidr}" ] && { echo "error: static requires CIDR (e.g. 192.168.1.1/24)"; exit 1; }
            norm_cidr="$(_validate_cidr "${cidr}")" || { echo "error: invalid CIDR '${cidr}'"; exit 1; }
            norm_gw=""
            [ -n "${gateway}" ] && { norm_gw="$(_validate_ip "${gateway}")" || { echo "error: invalid gateway '${gateway}'"; exit 1; }; }
            _sql "UPDATE ${tbl} SET ipv4_config_type='static',ipv4_address='${norm_cidr}',ipv4_upstream_gateway='${norm_gw}' WHERE id=1;"
            echo "${itype} set to static ${norm_cidr}${norm_gw:+ via ${norm_gw}}."
            if [ "${apply_now}" = "1" ]; then
                phys="$(_resolve_port "${itype}" || true)"
                if [ -n "${phys}" ]; then
                    ifconfig "${phys}" inet "${norm_cidr}" up
                    if [ "${itype}" = "WAN" ] && [ -n "${norm_gw}" ]; then
                        route -n delete default 2>/dev/null || true
                        route -n add default "${norm_gw}"
                    fi
                    echo "Applied on ${phys}."
                else
                    echo "No physical port assigned — DB updated only."
                fi
            fi
            ;;
        *) echo "error: mode must be dhcp or static"; exit 1 ;;
    esac
}

cmd_assign() {
    # smartshieldctl assign <LAN|WAN> <port>
    itype="$(echo "${1:-}" | tr '[:lower:]' '[:upper:]')"
    port="${2:-}"
    [ -z "${itype}" ] || [ -z "${port}" ] && { echo "usage: smartshieldctl assign <LAN|WAN> <port>"; exit 1; }
    _need_sqlite
    _sql "INSERT OR IGNORE INTO interface_assignments (interface_type, network_port) VALUES ('${itype}','${port}');
          UPDATE interface_assignments SET network_port='${port}' WHERE interface_type='${itype}';"
    # Also update assigned_port in lan_config/wan_config
    case "${itype}" in
        LAN) _sql "INSERT OR IGNORE INTO lan_config (id) VALUES (1); UPDATE lan_config SET assigned_port='${port}' WHERE id=1;" ;;
        WAN) _sql "INSERT OR IGNORE INTO wan_config (id) VALUES (1); UPDATE wan_config SET assigned_port='${port}' WHERE id=1;" ;;
    esac
    echo "${itype} assigned to port '${port}'."
}

cmd_list_nics() {
    echo "Available network interfaces:"
    ifconfig -l | tr ' ' '\n' | grep -v '^lo' | while read -r iface; do
        state="$(ifconfig "${iface}" 2>/dev/null | grep -c 'RUNNING' || true)"
        mac="$(ifconfig "${iface}" 2>/dev/null | grep 'ether ' | awk '{print $2}' | head -1)"
        ip="$(ifconfig  "${iface}" 2>/dev/null | grep 'inet '  | awk '{print $2}' | head -1)"
        printf "  %-10s  %-18s  %-16s  %s\n" \
            "${iface}" "${mac:-<no mac>}" "${ip:-<no ip>}" \
            "$([ "${state}" -gt 0 ] && echo UP || echo down)"
    done
}

cmd_ping() {
    host="${1:-8.8.8.8}"
    count="${2:-4}"
    ping -c "${count}" "${host}"
}

cmd_passwd() {
    # Reset the web UI admin password
    _need_sqlite
    _need_python
    user="${1:-admin}"
    printf "New password for '%s': " "${user}"
    stty -echo 2>/dev/null || true
    read -r newpass
    stty echo 2>/dev/null || true
    echo
    [ -z "${newpass}" ] && { echo "error: password cannot be empty"; exit 1; }
    hashed="$(python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('${newpass}'))" 2>/dev/null)"
    [ -z "${hashed}" ] && { echo "error: could not hash password (werkzeug not installed?)"; exit 1; }
    rows="$(_sql "UPDATE users SET password='${hashed}' WHERE username='${user}'; SELECT changes();")"
    if [ "${rows}" = "0" ]; then
        echo "User '${user}' not found."
        exit 1
    fi
    echo "Password for '${user}' updated."
}

cmd_factory_reset() {
    _need_sqlite
    echo "WARNING: This will delete all firewall rules, VPN tunnels, DHCP/DNS config,"
    echo "         interface settings, and certificates from the database."
    printf "Type RESET to confirm: "
    read -r confirm
    [ "${confirm}" = "RESET" ] || { echo "Aborted."; exit 0; }
    tables="firewall_rules_wan firewall_rules_lan firewall_rules_floating nat_pf nat_outbound nat_1to1
            firewall_aliases wan_config lan_config interface_assignments
            dhcp_pools static_leases openvpn_servers openvpn_clients
            ipsec_phase1 ipsec_phase2 ipsec_pre_shared_keys l2tp_config l2tp_users
            certificate_authorities service_state"
    for t in ${tables}; do
        _sql "DELETE FROM ${t};" 2>/dev/null || true
        _info "Cleared: ${t}"
    done
    echo "Factory reset complete. Restart the service and reconfigure from the web UI."
}

cmd_pf_status() {
    if ! command -v pfctl >/dev/null 2>&1; then
        echo "pfctl not found — pf not available on this system."
        exit 1
    fi
    echo "=== PF Status ==="
    pfctl -s info
    echo ""
    echo "=== Active Rules ==="
    pfctl -s rules 2>/dev/null | head -40 || true
    echo ""
    echo "=== NAT Rules ==="
    pfctl -s nat 2>/dev/null | head -20 || true
    echo ""
    echo "=== State Table (top 20) ==="
    pfctl -s states 2>/dev/null | head -20 || true
}

cmd_apply_pf() {
    _need_root
    _need_python
    _load_env
    echo "Generating pf.conf from database…"
    conf="$(python3 -c "
import sys; sys.path.insert(0,'${APP_ROOT}')
from app.database import get_db
from app.services.pf_generator import generate_pf_conf, validate_pf_conf, reload_pf_rules
conn = get_db()
result = reload_pf_rules(conn)
print(result['message'])
sys.exit(0 if result['ok'] else 1)
")"
    echo "${conf}"
}

cmd_preflight() {
    _need_python
    _load_env
    python3 - <<PY
import sys
sys.path.insert(0, '${APP_ROOT}')
from app.services.freebsd_setup import preflight_check
r = preflight_check()
print("Directories:")
for d in r["dirs"]:
    status = "OK" if d["ok"] else ("CREATED" if d.get("created") else "ERROR")
    print(f"  [{status:7s}] {d['path']}")
print("\nTools:")
for t in r["tools"]:
    s = "PRESENT" if t["present"] else ("OPTIONAL" if t.get("optional") else "MISSING")
    print(f"  [{s:7s}] {t['name']} — {t.get('description','')}")
if r["missing_required"]:
    print(f"\nMissing required tools: {', '.join(r['missing_required'])}")
if r["dir_errors"]:
    print(f"Directory errors: {', '.join(r['dir_errors'])}")
print(f"\nOverall: {'OK' if r['overall_ok'] else 'ISSUES FOUND'}")
sys.exit(0 if r["overall_ok"] else 1)
PY
}

cmd_vpn_status() {
    echo "=== OpenVPN ==="
    pgrep -a openvpn 2>/dev/null && echo "Running." || echo "Not running."
    echo ""
    echo "=== IPsec (strongSwan) ==="
    if command -v ipsec >/dev/null 2>&1; then
        ipsec statusall 2>/dev/null | head -30 || true
    else
        pgrep -a charon 2>/dev/null && echo "charon running." || echo "Not running."
    fi
    echo ""
    echo "=== L2TP (mpd5) ==="
    pgrep -a mpd5 2>/dev/null && echo "Running." || echo "Not running."
}

cmd_dhcp_status() {
    echo "=== ISC DHCP Server ==="
    service isc-dhcpd status 2>/dev/null || echo "Not running (or not installed)."
    echo ""
    echo "=== Active Leases ==="
    leases="/var/db/dhcpd/dhcpd.leases"
    if [ -f "${leases}" ]; then
        grep -A4 "^lease " "${leases}" | head -60
    else
        echo "Lease file not found: ${leases}"
    fi
}

cmd_dns_status() {
    echo "=== Unbound ==="
    service unbound status 2>/dev/null || echo "Not running."
    echo ""
    if command -v unbound-control >/dev/null 2>&1; then
        unbound-control status 2>/dev/null || true
    fi
}

cmd_ssh() {
    action="${1:-status}"
    case "${action}" in
        enable)
            _need_root
            sysrc sshd_enable=YES
            service sshd start
            echo "SSH enabled and started."
            ;;
        disable)
            _need_root
            service sshd stop 2>/dev/null || true
            sysrc sshd_enable=NO
            echo "SSH stopped and disabled."
            ;;
        status)
            service sshd status 2>/dev/null || echo "sshd not running."
            ;;
        *) echo "usage: smartshieldctl ssh <enable|disable|status>" ;;
    esac
}

cmd_sysinfo() {
    echo "=== System Information ==="
    uname -a
    echo ""
    echo "=== CPU ==="
    sysctl -n hw.model 2>/dev/null; sysctl -n hw.ncpu 2>/dev/null | xargs -I{} echo "{} CPU(s)"
    echo ""
    echo "=== Memory ==="
    sysctl -n hw.physmem 2>/dev/null | awk '{printf "Physical: %.1f GB\n", $1/1073741824}'
    vmstat -s 2>/dev/null | grep "pages free" | head -1 || true
    echo ""
    echo "=== Disk ==="
    df -h / 2>/dev/null
    echo ""
    echo "=== Uptime ==="
    uptime
}

cmd_shell() {
    exec /bin/sh
}

# ── Usage ─────────────────────────────────────────────────────────────────────

_usage() {
    cat <<EOF
smartshieldctl — Smart Shield operator tool

Service:
  start / stop / restart / status     Control the web service
  enable / disable                    Enable/disable at boot
  health                              HTTP check against web UI

Logging:
  logs [N]                            Tail app log (default 100 lines)
  audit [N]                           Tail audit log
  access [N]                          Tail access log

Interfaces:
  list-nics                           Show all physical NICs
  assign <LAN|WAN> <port>             Assign NIC to interface (e.g. em1)
  iface-show [LAN|WAN]               Show interface config + live IP
  iface-set <LAN|WAN> dhcp [--apply]
  iface-set <LAN|WAN> static <CIDR> [gw] [--apply]

Diagnostics:
  ping [host] [count]                 ICMP ping (default 8.8.8.8, 4 packets)
  pf-status                           Show pf rules, NAT, state table
  apply-pf                            Regenerate pf.conf and reload pfctl
  preflight                           Check dirs + tools
  vpn-status                          Show OpenVPN / IPsec / L2TP state
  dhcp-status                         Show DHCP leases
  dns-status                          Show Unbound status
  sysinfo                             CPU, RAM, disk, uptime

Administration:
  passwd [username]                   Reset web UI admin password
  factory-reset                       Wipe all config from DB
  ssh <enable|disable|status>         Control sshd
  shell                               Drop to /bin/sh
  menu                                Launch interactive console menu
EOF
}

# ── Dispatch ──────────────────────────────────────────────────────────────────

[ $# -eq 0 ] && { _usage; exit 0; }
cmd="$1"; shift || true

case "${cmd}" in
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart ;;
    status)         cmd_status ;;
    enable)         cmd_enable ;;
    disable)        cmd_disable ;;
    health)         cmd_health ;;
    logs)           cmd_logs "$@" ;;
    audit)          cmd_audit "$@" ;;
    access)         cmd_access "$@" ;;
    list-nics)      cmd_list_nics ;;
    assign)         cmd_assign "$@" ;;
    iface-show)     cmd_iface_show "$@" ;;
    iface-set)      cmd_iface_set "$@" ;;
    ping)           cmd_ping "$@" ;;
    pf-status)      cmd_pf_status ;;
    apply-pf)       cmd_apply_pf ;;
    preflight)      cmd_preflight ;;
    vpn-status)     cmd_vpn_status ;;
    dhcp-status)    cmd_dhcp_status ;;
    dns-status)     cmd_dns_status ;;
    sysinfo)        cmd_sysinfo ;;
    passwd)         cmd_passwd "$@" ;;
    factory-reset)  cmd_factory_reset ;;
    ssh)            cmd_ssh "$@" ;;
    shell)          cmd_shell ;;
    menu)           exec smartshield-cli ;;
    --help|-h|help) _usage ;;
    *) echo "Unknown command: ${cmd}"; echo "Run 'smartshieldctl --help' for usage."; exit 1 ;;
esac
