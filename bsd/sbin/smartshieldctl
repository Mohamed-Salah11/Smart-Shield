#!/bin/sh
# =============================================================================
# smartshieldctl — Smart Shield operator control tool for FreeBSD
# =============================================================================
# Install: install -m 0555 smartshieldctl /usr/local/sbin/smartshieldctl
# Usage:   smartshieldctl <command> [args]
# =============================================================================
set -eu

# ── Config ────────────────────────────────────────────────────────────────────
SERVICE_NAME="${SMARTSHIELD_SERVICE_NAME:-smart_shield}"
APP_ROOT="${SMARTSHIELD_APP_ROOT:-/usr/local/share/smartshield}"
ENV_FILE="${SMARTSHIELD_ENV_FILE:-/usr/local/etc/smartshield/smartshield.env}"
# Production DB lives under /var/db/smartshield (root-runtime). The previous
# fallback pointed at ${APP_ROOT}/data.db, which is the right location ONLY
# for in-tree development — running `smartshieldctl passwd admin` against a
# broken env file would silently bypass the real production DB and create a
# zero-byte sqlite file under APP_ROOT (Fv11 review §P0-04). The recovery
# tool must always pick the safest production default.
DEFAULT_DB="${SMARTSHIELD_DEFAULT_DB:-/var/db/smartshield/data.db}"
LOG_FILE="/var/log/smartshield/app.log"
AUDIT_LOG="/var/log/smartshield/audit.log"
ACCESS_LOG="/var/log/smartshield/access.log"
WEB_BIND="${SMARTSHIELD_BIND:-127.0.0.1:5000}"

# ── Helpers ───────────────────────────────────────────────────────────────────
_load_env() {
    [ -f "${ENV_FILE}" ] && . "${ENV_FILE}" || true
}

_db() {
    _load_env
    echo "${SMARTSHIELD_DB_PATH:-${DEFAULT_DB}}"
}

_need_sqlite() {
    command -v sqlite3 >/dev/null 2>&1 || { echo "error: sqlite3 not found"; exit 1; }
}

_need_python() {
    command -v python3 >/dev/null 2>&1 || { echo "error: python3 not found"; exit 1; }
}

_need_root() {
    [ "$(id -u)" -eq 0 ] || { echo "error: this command requires root"; exit 1; }
}

_sql() {
    _need_sqlite
    sqlite3 "$(_db)" "$1"
}

# _sql_param <mode> [args...]
#
# Parameterized SQLite helper for any command that writes to or filters by
# user-controlled input. The shell-interpolated _sql() above is fine for
# fixed-string queries (factory_reset, pf_status, the SELECT-everything in
# iface_show) but fails — sometimes silently, sometimes destructively — when
# the argument can contain quotes or backslashes. Fv11 review §P0-05 flagged
# the password reset and interface-assignment paths as the high-risk
# offenders.
#
# Each mode below corresponds to one historical _sql() callsite that took
# user input. Add a new mode here before adding a new sqlite3 "$1" call.
_sql_param() {
    _need_python
    _db_path="$(_db)"
    python3 - "${_db_path}" "$@" <<'PY'
import sqlite3
import sys

db_path = sys.argv[1]
mode    = sys.argv[2]
args    = sys.argv[3:]

conn = sqlite3.connect(db_path)
try:
    if mode == "resolve_port":
        itype = args[0]
        row = conn.execute(
            "SELECT network_port FROM interface_assignments "
            "WHERE interface_type=? LIMIT 1",
            (itype,),
        ).fetchone()
        print(row[0] if row and row[0] else "")
    elif mode == "assign_port":
        # interface_assignments + lan_config/wan_config in one transaction so
        # an interrupt mid-flight can't leave the two tables disagreeing about
        # which physical port owns LAN/WAN.
        itype, port = args
        conn.execute(
            "INSERT OR IGNORE INTO interface_assignments "
            "(interface_type, network_port) VALUES (?, ?)",
            (itype, port),
        )
        conn.execute(
            "UPDATE interface_assignments SET network_port=? "
            "WHERE interface_type=?",
            (port, itype),
        )
        table = "lan_config" if itype == "LAN" else "wan_config"
        # Whitelist guard — sqlite3 cannot parameterize identifiers, so the
        # table name is selected from a fixed two-element set.
        if table not in ("lan_config", "wan_config"):
            raise SystemExit(f"refusing unexpected table: {table!r}")
        conn.execute(f"INSERT OR IGNORE INTO {table} (id) VALUES (1)")
        conn.execute(f"UPDATE {table} SET assigned_port=? WHERE id=1", (port,))
        conn.commit()
    elif mode == "set_password":
        username, hashed = args
        conn.execute(
            "UPDATE users SET password=? WHERE username=?",
            (hashed, username),
        )
        # changes() returns -1 if no statement has executed in the connection;
        # explicit fetchone() gives us a row count we can act on.
        changed = conn.execute("SELECT changes()").fetchone()[0]
        conn.commit()
        print(changed)
    else:
        raise SystemExit(f"unknown _sql_param mode: {mode!r}")
finally:
    conn.close()
PY
}

_validate_cidr() {
    _need_python
    python3 - "$1" <<'PY'
import ipaddress, sys
try:
    i = ipaddress.ip_interface(sys.argv[1])
    print(i.with_prefixlen)
except Exception:
    raise SystemExit(1)
PY
}

_validate_ip() {
    _need_python
    python3 - "$1" <<'PY'
import ipaddress, sys
try:
    print(str(ipaddress.ip_address(sys.argv[1])))
except Exception:
    raise SystemExit(1)
PY
}

_resolve_port() {
    # Returns the physical port (e.g. em0) assigned to WAN or LAN.
    # Uses the parameterized helper because interface_type is supplied by the
    # operator on the command line — a value containing a quote would have
    # mangled the old shell-interpolated SELECT.
    itype="$1"
    raw="$(_sql_param resolve_port "${itype}")"
    echo "${raw}" | awk '{print $1}' | tr -cd 'A-Za-z0-9_.:-'
}

_color() {
    # _color <code> <text>
    printf "\033[%sm%s\033[0m" "$1" "$2"
}

_ok()   { printf "  [ $(_color '0;32' 'OK')     ] %s\n" "$1"; }
_warn() { printf "  [ $(_color '0;33' 'WARN')   ] %s\n" "$1"; }
_err()  { printf "  [ $(_color '0;31' 'ERROR')  ] %s\n" "$1"; }
_info() { printf "  [ $(_color '0;34' 'INFO')   ] %s\n" "$1"; }

# ── Commands ──────────────────────────────────────────────────────────────────

cmd_start()   { _need_root; service "${SERVICE_NAME}" start; }
cmd_stop()    { _need_root; service "${SERVICE_NAME}" stop; }
cmd_restart() { _need_root; service "${SERVICE_NAME}" restart; }
cmd_status()  { service "${SERVICE_NAME}" status; }
cmd_enable()  { _need_root; sysrc "${SERVICE_NAME}_enable=YES"; echo "Enabled at boot."; }
cmd_disable() { _need_root; sysrc "${SERVICE_NAME}_enable=NO";  echo "Disabled at boot."; }

cmd_logs() {
    lines="${1:-100}"
    tail -n "${lines}" "${LOG_FILE}" 2>/dev/null || echo "Log not found: ${LOG_FILE}"
}

cmd_audit() {
    lines="${1:-100}"
    tail -n "${lines}" "${AUDIT_LOG}" 2>/dev/null || echo "Log not found: ${AUDIT_LOG}"
}

cmd_access() {
    lines="${1:-50}"
    tail -n "${lines}" "${ACCESS_LOG}" 2>/dev/null || echo "Log not found: ${ACCESS_LOG}"
}

cmd_health() {
    url="http://${WEB_BIND}/login"
    if fetch -qo /dev/null "${url}" 2>/dev/null; then
        _ok "Web UI reachable at ${url}"
    elif curl -fsS -o /dev/null "${url}" 2>/dev/null; then
        _ok "Web UI reachable at ${url}"
    else
        _err "Web UI NOT reachable at ${url}"
        exit 1
    fi
}

cmd_iface_show() {
    itype="$(echo "${1:-LAN}" | tr '[:lower:]' '[:upper:]')"
    case "${itype}" in LAN) tbl="lan_config" ;; WAN) tbl="wan_config" ;; *)
        echo "error: expected LAN or WAN"; exit 1 ;; esac
    _need_sqlite
    row="$(_sql "SELECT COALESCE(assigned_port,''), COALESCE(ipv4_config_type,''), COALESCE(ipv4_address,''), COALESCE(ipv4_upstream_gateway,'') FROM ${tbl} WHERE id=1;")"
    port="$(echo "${row}" | cut -d'|' -f1)"
    mode="$(echo "${row}" | cut -d'|' -f2)"
    addr="$(echo "${row}" | cut -d'|' -f3)"
    gw="$(echo "${row}" | cut -d'|' -f4)"
    phys="$(_resolve_port "${itype}" || true)"
    echo "Interface     : ${itype}"
    echo "Physical Port : ${phys:-${port:-<unassigned>}}"
    echo "IPv4 Mode     : ${mode:-unknown}"
    echo "IPv4 Address  : ${addr:-<empty>}"
    echo "IPv4 Gateway  : ${gw:-<empty>}"
    # Live state from ifconfig — convert FreeBSD hex netmask (0xffffff00) to CIDR prefix
    if [ -n "${phys}" ] && command -v ifconfig >/dev/null 2>&1; then
        live="$(ifconfig "${phys}" 2>/dev/null | python3 -c "
import sys, re
for line in sys.stdin:
    m = re.search(r'inet\s+(\S+)\s+netmask\s+(\S+)', line)
    if m:
        ip, mask = m.group(1), m.group(2)
        pfx = bin(int(mask, 16)).count('1') if mask.startswith('0x') else mask
        print(ip + '/' + str(pfx))
        break
" 2>/dev/null)"
        echo "Live IP       : ${live:-<none>}"
        state="$(ifconfig "${phys}" 2>/dev/null | grep -c 'RUNNING' || true)"
        echo "Link          : $([ "${state}" -gt 0 ] && echo UP || echo DOWN)"
    fi
}

cmd_iface_set() {
    itype="$(echo "${1:-}" | tr '[:lower:]' '[:upper:]')"
    mode="$(echo "${2:-}" | tr '[:upper:]' '[:lower:]')"
    [ -z "${itype}" ] || [ -z "${mode}" ] && { _usage; exit 1; }
    shift 2 || true
    case "${itype}" in LAN) tbl="lan_config" ;; WAN) tbl="wan_config" ;; *)
        echo "error: expected LAN or WAN"; exit 1 ;; esac
    _need_sqlite
    apply_now=0; cidr=""; gateway=""
    for a in "$@"; do
        case "${a}" in --apply) apply_now=1 ;;
            *) [ -z "${cidr}" ] && cidr="${a}" || gateway="${a}" ;;
        esac
    done
    _sql "INSERT OR IGNORE INTO ${tbl} (id) VALUES (1);"
    case "${mode}" in
        dhcp)
            _sql "UPDATE ${tbl} SET ipv4_config_type='dhcp',ipv4_address='',ipv4_upstream_gateway='' WHERE id=1;"
            echo "${itype} configured as DHCP."
            if [ "${apply_now}" = "1" ]; then
                phys="$(_resolve_port "${itype}" || true)"
                if [ -n "${phys}" ]; then
                    # FreeBSD 13: dhclient in base. FreeBSD 14: dhcpcd in base.
                    if command -v dhclient >/dev/null 2>&1; then
                        _dhcp_bin="dhclient"
                    elif command -v dhcpcd >/dev/null 2>&1; then
                        _dhcp_bin="dhcpcd"
                    else
                        echo "error: no DHCP client found (dhclient or dhcpcd)"; exit 1
                    fi
                    ifconfig "${phys}" up
                    "${_dhcp_bin}" "${phys}"
                    echo "DHCP lease requested on ${phys} via ${_dhcp_bin}."
                else
                    echo "No physical port assigned — DB updated only."
                fi
            fi
            ;;
        static)
            [ -z "${cidr}" ] && { echo "error: static requires CIDR (e.g. 192.168.1.1/24)"; exit 1; }
            norm_cidr="$(_validate_cidr "${cidr}")" || { echo "error: invalid CIDR '${cidr}'"; exit 1; }
            norm_gw=""
            [ -n "${gateway}" ] && { norm_gw="$(_validate_ip "${gateway}")" || { echo "error: invalid gateway '${gateway}'"; exit 1; }; }
            _sql "UPDATE ${tbl} SET ipv4_config_type='static',ipv4_address='${norm_cidr}',ipv4_upstream_gateway='${norm_gw}' WHERE id=1;"
            echo "${itype} set to static ${norm_cidr}${norm_gw:+ via ${norm_gw}}."
            if [ "${apply_now}" = "1" ]; then
                phys="$(_resolve_port "${itype}" || true)"
                if [ -n "${phys}" ]; then
                    ifconfig "${phys}" inet "${norm_cidr}" up
                    if [ "${itype}" = "WAN" ] && [ -n "${norm_gw}" ]; then
                        route -n delete default 2>/dev/null || true
                        route -n add default "${norm_gw}"
                    fi
                    echo "Applied on ${phys}."
                else
                    echo "No physical port assigned — DB updated only."
                fi
            fi
            ;;
        *) echo "error: mode must be dhcp or static"; exit 1 ;;
    esac
}

cmd_assign() {
    # smartshieldctl assign <LAN|WAN> <port>
    itype="$(echo "${1:-}" | tr '[:lower:]' '[:upper:]')"
    # Sanitize port: allow only alphanumeric, dots, colons, underscores, hyphens.
    # This is the outer guard; the inner _sql_param call still uses bound
    # parameters so any byte that slips through is treated as data, not SQL.
    port="$(echo "${2:-}" | tr -cd 'A-Za-z0-9_.:-')"
    if [ -z "${itype}" ] || [ -z "${port}" ]; then
        echo "usage: smartshieldctl assign <LAN|WAN> <port>"
        exit 1
    fi
    case "${itype}" in
        LAN|WAN) ;;
        *) echo "error: interface must be LAN or WAN"; exit 1 ;;
    esac
    _sql_param assign_port "${itype}" "${port}"
    echo "${itype} assigned to port '${port}'."
}

cmd_list_nics() {
    echo "Available network interfaces:"
    ifconfig -l | tr ' ' '\n' | grep -v '^lo' | while read -r iface; do
        state="$(ifconfig "${iface}" 2>/dev/null | grep -c 'RUNNING' || true)"
        mac="$(ifconfig "${iface}" 2>/dev/null | grep 'ether ' | awk '{print $2}' | head -1)"
        ip="$(ifconfig  "${iface}" 2>/dev/null | grep 'inet '  | awk '{print $2}' | head -1)"
        printf "  %-10s  %-18s  %-16s  %s\n" \
            "${iface}" "${mac:-<no mac>}" "${ip:-<no ip>}" \
            "$([ "${state}" -gt 0 ] && echo UP || echo down)"
    done
}

cmd_ping() {
    host="${1:-8.8.8.8}"
    count="${2:-4}"
    ping -c "${count}" "${host}"
}

cmd_passwd() {
    # Reset the web UI admin password
    _need_sqlite
    _need_python
    user="${1:-admin}"
    printf "New password for '%s': " "${user}"
    stty -echo 2>/dev/null || true
    read -r newpass
    stty echo 2>/dev/null || true
    echo
    [ -z "${newpass}" ] && { echo "error: password cannot be empty"; exit 1; }
    # Pass the password via env var to avoid shell injection when the
    # password contains single quotes, backslashes, or other special chars.
    hashed="$(_SS_PASSWD="${newpass}" python3 -c "
import os
from werkzeug.security import generate_password_hash
print(generate_password_hash(os.environ['_SS_PASSWD']))
" 2>/dev/null)"
    [ -z "${hashed}" ] && { echo "error: could not hash password (werkzeug not installed?)"; exit 1; }
    # Parameterized UPDATE so a username like  admin'test  no longer breaks
    # the statement or risks accidental data damage (Fv11 review §P0-05).
    rows="$(_sql_param set_password "${user}" "${hashed}")"
    if [ "${rows}" = "0" ]; then
        echo "User '${user}' not found."
        exit 1
    fi
    echo "Password for '${user}' updated."
}

cmd_factory_reset() {
    _need_sqlite
    echo "WARNING: This will delete all firewall rules, VPN tunnels, DHCP/DNS config,"
    echo "         interface settings, and certificates from the database."
    printf "Type RESET to confirm: "
    read -r confirm
    [ "${confirm}" = "RESET" ] || { echo "Aborted."; exit 0; }
    tables="firewall_rules_wan firewall_rules_lan firewall_rules_floating nat_pf nat_outbound nat_1to1
            firewall_aliases wan_config lan_config interface_assignments
            dhcp_pools static_leases openvpn_servers openvpn_clients
            ipsec_phase1 ipsec_phase2 ipsec_pre_shared_keys l2tp_config l2tp_users
            certificate_authorities service_state"
    for t in ${tables}; do
        _sql "DELETE FROM ${t};" 2>/dev/null || true
        _info "Cleared: ${t}"
    done
    echo "Factory reset complete. Restart the service and reconfigure from the web UI."
}

cmd_pf_status() {
    if ! command -v pfctl >/dev/null 2>&1; then
        echo "pfctl not found — pf not available on this system."
        exit 1
    fi
    echo "=== PF Status ==="
    pfctl -s info
    echo ""
    echo "=== Active Rules ==="
    pfctl -s rules 2>/dev/null | head -40 || true
    echo ""
    echo "=== NAT Rules ==="
    pfctl -s nat 2>/dev/null | head -20 || true
    echo ""
    echo "=== State Table (top 20) ==="
    pfctl -s states 2>/dev/null | head -20 || true
}

cmd_apply_pf() {
    _need_root
    _need_python
    _load_env
    echo "Generating pf.conf from database…"
    conf="$(python3 -c "
import sys; sys.path.insert(0,'${APP_ROOT}')
from app.database import get_db
from app.services.pf_generator import generate_pf_conf, validate_pf_conf, reload_pf_rules
conn = get_db()
result = reload_pf_rules(conn)
print(result['message'])
sys.exit(0 if result['ok'] else 1)
")"
    echo "${conf}"
}

cmd_preflight() {
    _need_python
    _load_env
    python3 - <<PY
import sys
sys.path.insert(0, '${APP_ROOT}')
from app.services.freebsd_setup import preflight_check
r = preflight_check()
print("Directories:")
for d in r["dirs"]:
    status = "OK" if d["ok"] else ("CREATED" if d.get("created") else "ERROR")
    print(f"  [{status:7s}] {d['path']}")
print("\nTools:")
for t in r["tools"]:
    s = "PRESENT" if t["present"] else ("OPTIONAL" if t.get("optional") else "MISSING")
    print(f"  [{s:7s}] {t['name']} — {t.get('description','')}")
if r["missing_required"]:
    print(f"\nMissing required tools: {', '.join(r['missing_required'])}")
if r["dir_errors"]:
    print(f"Directory errors: {', '.join(r['dir_errors'])}")
print(f"\nOverall: {'OK' if r['overall_ok'] else 'ISSUES FOUND'}")
sys.exit(0 if r["overall_ok"] else 1)
PY
}

cmd_verify() {
    # smartshieldctl verify {startup|deployment} [--json]
    sub="${1:-deployment}"; shift 2>/dev/null || true
    json_mode=0
    for arg in "$@"; do
        [ "${arg}" = "--json" ] && json_mode=1
    done

    _need_python
    _load_env

    case "${sub}" in
        startup)
            # Drive tools/smoke_startup.py; exit 0 iff create_app() succeeds.
            if [ "${json_mode}" -eq 1 ]; then
                python3 - <<PY
import json, sys
sys.path.insert(0, "${APP_ROOT}")
try:
    from app import create_app
    app = create_app()
    routes = sum(1 for _ in app.url_map.iter_rules())
    print(json.dumps({"ok": True, "blueprints": len(app.blueprints),
                      "routes": routes, "database": "ok"}))
except Exception as exc:
    print(json.dumps({"ok": False, "error": str(exc)}))
    sys.exit(1)
PY
            else
                exec python3 "${APP_ROOT}/tools/smoke_startup.py"
            fi
            ;;
        deployment)
            # Umbrella: startup + release_check + security_lint_routes.
            # Exit non-zero if any check fails.
            python3 - <<PY
import json, sys, subprocess
sys.path.insert(0, "${APP_ROOT}")

results = {}
ok = True

# 1. Startup
try:
    from app import create_app
    app = create_app()
    results["startup"] = {
        "ok": True,
        "blueprints": len(app.blueprints),
        "routes": sum(1 for _ in app.url_map.iter_rules()),
    }
except Exception as exc:
    results["startup"] = {"ok": False, "error": str(exc)}
    ok = False

# 2. Release check
try:
    rc = subprocess.run(
        [sys.executable, "${APP_ROOT}/tools/release_check.py"],
        capture_output=True, text=True, timeout=60,
    )
    results["release_check"] = {"ok": rc.returncode == 0,
                                  "stdout_tail": rc.stdout[-2000:],
                                  "stderr_tail": rc.stderr[-2000:]}
    if rc.returncode != 0:
        ok = False
except Exception as exc:
    results["release_check"] = {"ok": False, "error": str(exc)}
    ok = False

# 3. Route security lint
try:
    rc = subprocess.run(
        [sys.executable, "${APP_ROOT}/tools/security_lint_routes.py"],
        capture_output=True, text=True, timeout=60,
    )
    results["security_lint_routes"] = {
        "ok": rc.returncode == 0,
        "stdout_tail": rc.stdout[-2000:],
        "stderr_tail": rc.stderr[-2000:],
    }
    if rc.returncode != 0:
        ok = False
except Exception as exc:
    results["security_lint_routes"] = {"ok": False, "error": str(exc)}
    ok = False

if ${json_mode}:
    print(json.dumps({"ok": ok, "checks": results}, indent=2))
else:
    for name, r in results.items():
        flag = "OK" if r.get("ok") else "FAIL"
        print(f"[{flag:4s}] {name}")
        if not r.get("ok") and r.get("error"):
            print(f"        error: {r['error']}")
    print(f"\nOverall: {'PASS' if ok else 'FAIL'}")

sys.exit(0 if ok else 1)
PY
            ;;
        *)
            echo "Unknown verify target: ${sub}"
            echo "Usage: smartshieldctl verify {startup|deployment} [--json]"
            exit 1
            ;;
    esac
}

cmd_vpn_status() {
    echo "=== OpenVPN ==="
    pgrep -a openvpn 2>/dev/null && echo "Running." || echo "Not running."
    echo ""
    echo "=== IPsec (strongSwan) ==="
    if command -v ipsec >/dev/null 2>&1; then
        ipsec statusall 2>/dev/null | head -30 || true
    else
        pgrep -a charon 2>/dev/null && echo "charon running." || echo "Not running."
    fi
    echo ""
    echo "=== L2TP (mpd5) ==="
    pgrep -a mpd5 2>/dev/null && echo "Running." || echo "Not running."
}

cmd_dhcp_status() {
    echo "=== ISC DHCP Server ==="
    service isc-dhcpd status 2>/dev/null || echo "Not running (or not installed)."
    echo ""
    echo "=== Active Leases ==="
    leases="/var/db/dhcpd/dhcpd.leases"
    if [ -f "${leases}" ]; then
        grep -A4 "^lease " "${leases}" | head -60
    else
        echo "Lease file not found: ${leases}"
    fi
}

cmd_dns_status() {
    echo "=== Unbound ==="
    service unbound status 2>/dev/null || echo "Not running."
    echo ""
    if command -v unbound-control >/dev/null 2>&1; then
        unbound-control status 2>/dev/null || true
    fi
}

cmd_ssh() {
    action="${1:-status}"
    case "${action}" in
        enable)
            _need_root
            sysrc sshd_enable=YES
            service sshd start
            echo "SSH enabled and started."
            ;;
        disable)
            _need_root
            service sshd stop 2>/dev/null || true
            sysrc sshd_enable=NO
            echo "SSH stopped and disabled."
            ;;
        status)
            service sshd status 2>/dev/null || echo "sshd not running."
            ;;
        *) echo "usage: smartshieldctl ssh <enable|disable|status>" ;;
    esac
}

cmd_sysinfo() {
    echo "=== System Information ==="
    uname -a
    echo ""
    echo "=== CPU ==="
    sysctl -n hw.model 2>/dev/null; sysctl -n hw.ncpu 2>/dev/null | xargs -I{} echo "{} CPU(s)"
    echo ""
    echo "=== Memory ==="
    sysctl -n hw.physmem 2>/dev/null | awk '{printf "Physical: %.1f GB\n", $1/1073741824}'
    vmstat -s 2>/dev/null | grep "pages free" | head -1 || true
    echo ""
    echo "=== Disk ==="
    df -h / 2>/dev/null
    echo ""
    echo "=== Uptime ==="
    uptime
}

cmd_shell() {
    exec /bin/sh
}

cmd_db_path() {
    # Print the production DB path the rest of this script will use. Useful
    # when the operator wants to confirm the env file is being read and the
    # /var/db fallback applies (Fv11 review §P0-04 acceptance check).
    _db
}

cmd_doctor() {
    # Fv11 review §P3-01: one-command appliance health check. Each line is a
    # PASS/WARN/FAIL with the underlying observation, so the operator can
    # paste the output into a support thread without further triage.
    fail=0
    _doctor_check() {
        # _doctor_check <label> <command...>  — exit code 0 → OK, non-zero → FAIL.
        # `eval` lets the caller pass shell tests (e.g. `[ -f /foo ]`) verbatim.
        _label="$1"; shift
        if eval "$@" >/dev/null 2>&1; then
            _ok "${_label}"
        else
            _err "${_label}"
            fail=$((fail + 1))
        fi
    }
    _doctor_warn() {
        _label="$1"; shift
        if eval "$@" >/dev/null 2>&1; then
            _ok "${_label}"
        else
            _warn "${_label}"
        fi
    }

    echo "=== Smart Shield doctor ==="

    # ── Config / secrets ────────────────────────────────────────────────────
    _doctor_check "env file present (${ENV_FILE})"        "[ -f '${ENV_FILE}' ]"
    _doctor_check "env file mode 0600"                    "[ \"\$(stat -f '%Lp' '${ENV_FILE}' 2>/dev/null)\" = '600' ]"
    _doctor_check "SECRET_KEY set and not a placeholder"  "grep -qE '^SECRET_KEY=[0-9a-fA-F]{16,}' '${ENV_FILE}' && ! grep -qE '^SECRET_KEY=(CHANGE_ME|please-change|changeme)' '${ENV_FILE}'"
    _doctor_check "master.key present"                    "[ -f '/usr/local/etc/smartshield/master.key' ]"
    _doctor_check "master.key mode 0600"                  "[ \"\$(stat -f '%Lp' '/usr/local/etc/smartshield/master.key' 2>/dev/null)\" = '600' ]"

    # ── Database ────────────────────────────────────────────────────────────
    _db_path="$(_db)"
    _doctor_check "database file exists (${_db_path})"    "[ -f '${_db_path}' ]"
    _doctor_check "database directory writable"           "[ -w \"\$(dirname '${_db_path}')\" ]"

    # ── Service / web ───────────────────────────────────────────────────────
    _doctor_warn "smart_shield enabled at boot"           "sysrc -n ${SERVICE_NAME}_enable | grep -qi '^yes$'"
    _doctor_warn "smart_shield service running"           "service ${SERVICE_NAME} status"
    _doctor_warn "nginx enabled at boot"                  "sysrc -n nginx_enable | grep -qi '^yes$'"
    _doctor_warn "nginx running"                          "service nginx status"
    _doctor_warn "PF enabled at boot"                     "sysrc -n pf_enable | grep -qi '^yes$'"
    _doctor_warn "web UI reachable at ${WEB_BIND}/login"  "{ fetch -qo /dev/null http://${WEB_BIND}/login 2>/dev/null || curl -fsS -o /dev/null http://${WEB_BIND}/login 2>/dev/null; }"

    # ── Suricata (P1-08 visibility) ─────────────────────────────────────────
    if command -v suricata >/dev/null 2>&1; then
        _doctor_check "suricata config valid (suricata -T)" "suricata -T -c /usr/local/etc/suricata/suricata.yaml"
        _doctor_warn "suricata-update available"           "command -v suricata-update"
        _doctor_warn "suricata rules file non-empty"       "[ -s /var/lib/suricata/rules/suricata.rules ]"
    else
        _info "Suricata not installed — IDS section skipped"
    fi

    # ── Disk / logs ─────────────────────────────────────────────────────────
    _doctor_warn "log directory writable"                 "[ -w '/var/log/smartshield' ]"

    echo ""
    if [ "${fail}" -eq 0 ]; then
        _ok "All required checks passed."
    else
        _err "${fail} required check(s) failed."
        exit 1
    fi
}

# ── Usage ─────────────────────────────────────────────────────────────────────

_usage() {
    cat <<EOF
smartshieldctl — Smart Shield operator tool

Service:
  start / stop / restart / status     Control the web service
  enable / disable                    Enable/disable at boot
  health                              HTTP check against web UI

Logging:
  logs [N]                            Tail app log (default 100 lines)
  audit [N]                           Tail audit log
  access [N]                          Tail access log

Interfaces:
  list-nics                           Show all physical NICs
  assign <LAN|WAN> <port>             Assign NIC to interface (e.g. em1)
  iface-show [LAN|WAN]               Show interface config + live IP
  iface-set <LAN|WAN> dhcp [--apply]
  iface-set <LAN|WAN> static <CIDR> [gw] [--apply]

Diagnostics:
  ping [host] [count]                 ICMP ping (default 8.8.8.8, 4 packets)
  pf-status                           Show pf rules, NAT, state table
  apply-pf                            Regenerate pf.conf and reload pfctl
  preflight                           Check dirs + tools (alias of legacy)
  verify startup [--json]             Smoke-test the Flask app boots cleanly
  verify deployment [--json]          Full deployment readiness report
  vpn-status                          Show OpenVPN / IPsec / L2TP state
  dhcp-status                         Show DHCP leases
  dns-status                          Show Unbound status
  sysinfo                             CPU, RAM, disk, uptime

Administration:
  passwd [username]                   Reset web UI admin password
  factory-reset                       Wipe all config from DB
  ssh <enable|disable|status>         Control sshd
  shell                               Drop to /bin/sh
  menu                                Launch interactive console menu

Support:
  db-path                             Print the production DB path in use
  doctor                              One-shot appliance health report
EOF
}

# ── Dispatch ──────────────────────────────────────────────────────────────────

[ $# -eq 0 ] && { _usage; exit 0; }
cmd="$1"; shift || true

case "${cmd}" in
    start)          cmd_start ;;
    stop)           cmd_stop ;;
    restart)        cmd_restart ;;
    status)         cmd_status ;;
    enable)         cmd_enable ;;
    disable)        cmd_disable ;;
    health)         cmd_health ;;
    logs)           cmd_logs "$@" ;;
    audit)          cmd_audit "$@" ;;
    access)         cmd_access "$@" ;;
    list-nics)      cmd_list_nics ;;
    assign)         cmd_assign "$@" ;;
    iface-show)     cmd_iface_show "$@" ;;
    iface-set)      cmd_iface_set "$@" ;;
    ping)           cmd_ping "$@" ;;
    pf-status)      cmd_pf_status ;;
    apply-pf)       cmd_apply_pf ;;
    preflight)      cmd_preflight ;;
    verify)         cmd_verify "$@" ;;
    vpn-status)     cmd_vpn_status ;;
    dhcp-status)    cmd_dhcp_status ;;
    dns-status)     cmd_dns_status ;;
    sysinfo)        cmd_sysinfo ;;
    passwd)         cmd_passwd "$@" ;;
    factory-reset)  cmd_factory_reset ;;
    ssh)            cmd_ssh "$@" ;;
    shell)          cmd_shell ;;
    menu)           exec smartshield-cli ;;
    db-path)        cmd_db_path ;;
    doctor)         cmd_doctor ;;
    --help|-h|help) _usage ;;
    *) echo "Unknown command: ${cmd}"; echo "Run 'smartshieldctl --help' for usage."; exit 1 ;;
esac
