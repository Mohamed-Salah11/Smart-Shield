#!/bin/sh
# Smart Shield console menu for appliance-style local administration.
#
# What to do with this file:
# 1) Copy to: /usr/local/sbin/smartshield-cli
# 2) Make executable: chmod 555 /usr/local/sbin/smartshield-cli
# 3) Run manually on console, or configure admin shell/login profile
#    to launch it automatically on tty for pfSense-style workflow.
#
# Typical integration approaches:
# - Keep root shell default and run smartshield-cli manually.
# - Create dedicated admin user with login shell wrapper that launches
#   smartshield-cli after authentication.
# - Use /etc/gettytab + /etc/ttys automation carefully for kiosk console.
#
# This menu intentionally delegates service actions to smartshieldctl.
# Extend options here as smartshieldctl gains apply/rollback subcommands.
set -eu

pause() {
    printf "\nPress Enter to continue..."
    read -r _
}

run_ctl() {
    if smartshieldctl "$@"; then
        :
    else
        echo "Command failed: smartshieldctl $*"
    fi
    pause
}

configure_interface() {
    iface="$1"
    mode=""
    cidr=""
    gateway=""
    apply_now=""

    echo "Current ${iface} settings:"
    smartshieldctl iface-show "${iface}" || true
    echo

    printf "Set ${iface} IPv4 mode [dhcp/static]: "
    read -r mode
    mode="$(echo "${mode}" | tr '[:upper:]' '[:lower:]')"

    case "${mode}" in
        dhcp)
            printf "Apply now on assigned interface? [y/N]: "
            read -r apply_now
            case "${apply_now}" in
                y|Y) run_ctl iface-set "${iface}" dhcp --apply ;;
                *) run_ctl iface-set "${iface}" dhcp ;;
            esac
            ;;
        static)
            printf "Enter static IPv4 CIDR (example 192.168.1.1/24): "
            read -r cidr
            if [ -z "${cidr}" ]; then
                echo "CIDR is required for static mode."
                pause
                return
            fi
            printf "Enter gateway IPv4 (optional): "
            read -r gateway
            printf "Apply now on assigned interface? [y/N]: "
            read -r apply_now

            if [ -n "${gateway}" ]; then
                case "${apply_now}" in
                    y|Y) run_ctl iface-set "${iface}" static "${cidr}" "${gateway}" --apply ;;
                    *) run_ctl iface-set "${iface}" static "${cidr}" "${gateway}" ;;
                esac
            else
                case "${apply_now}" in
                    y|Y) run_ctl iface-set "${iface}" static "${cidr}" --apply ;;
                    *) run_ctl iface-set "${iface}" static "${cidr}" ;;
                esac
            fi
            ;;
        *)
            echo "Invalid mode. Use 'dhcp' or 'static'."
            pause
            ;;
    esac
}

while :; do
    clear
    cat <<'EOF'
=========================================
 Smart Shield Console (FreeBSD Appliance)
=========================================
1) Service status
2) Start service
3) Stop service
4) Restart service
5) Tail logs
6) Tail audit log
7) Tail PF filter log
8) Enable service at boot
9) Disable service at boot
10) Configure LAN IPv4 mode
11) Configure WAN IPv4 mode
n) Network apply reminder
r) Reboot system
0) Shutdown system
q) Quit to shell
EOF

    printf "\nSelect option: "
    read -r choice

    case "${choice}" in
        1) run_ctl status ;;
        2) run_ctl start ;;
        3) run_ctl stop ;;
        4) run_ctl restart ;;
        5)
            printf "Tail how many lines? [100]: "
            read -r n
            n="${n:-100}"
            run_ctl logs "${n}"
            ;;
        8)
            run_ctl enable
            ;;
        9)
            run_ctl disable
            ;;
        10)
            configure_interface "LAN"
            ;;
        11)
            configure_interface "WAN"
            ;;
        6)
            printf "Tail how many audit lines? [100]: "
            read -r n
            n="${n:-100}"
            run_ctl audit "${n}"
            ;;
        7)
            printf "Tail how many PF filter lines? [100]: "
            read -r n
            n="${n:-100}"
            run_ctl filterlog "${n}"
            ;;
        n|N)
            echo "Use Web UI actions for config apply (CSRF-protected API)."
            echo "In future, wire smartshieldctl apply-* commands to backend workers."
            pause
            ;;
        r|R)
            printf "Reboot now? [y/N]: "
            read -r yn
            case "${yn}" in
                y|Y) reboot ;;
                *) ;;
            esac
            ;;
        0)
            printf "Shutdown now? [y/N]: "
            read -r yn
            case "${yn}" in
                y|Y) shutdown -p now ;;
                *) ;;
            esac
            ;;
        q|Q) exit 0 ;;
        *)
            echo "Invalid option."
            pause
            ;;
    esac
done
