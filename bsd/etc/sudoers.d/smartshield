# ── /boot/loader.conf persistence (priv_helper "sysrc.loader_set") ─────────────
# Only the kernel-module-load knobs we actually flip from the GUI. Each grant
# matches the literal single-token `key=value` argv that priv_helper builds.
smartshield ALL=(root) NOPASSWD: /usr/sbin/sysrc -f /boot/loader.conf netmap_load=YES
smartshield ALL=(root) NOPASSWD: /usr/sbin/sysrc -f /boot/loader.conf netmap_load=NO

# ── Package management: intentionally NOT granted via sudo ────────────────────
# priv_helper defines pkg.install / pkg.delete, but granting `pkg install/delete`
# to the service user would let a web-app compromise install arbitrary software.
# Package management is therefore root-runtime-only: those actions work when
# Smart Shield runs as root (the default), and are unavailable under the
# unprivileged sudo model by design. Do NOT add `/usr/sbin/pkg install|delete`.
