# =============================================================================
# Smart Shield — sudoers rules for least-privilege operation
# =============================================================================
# Install:
#   install -m 0440 smartshield /usr/local/etc/sudoers.d/smartshield
#
# Deployment model
# ----------------
# This file is the DEFENSE-IN-DEPTH FALLBACK for non-root deployments.
#
# The default appliance shipped by bsd/rc.d/smart_shield runs the Flask/gunicorn
# process as `root`, so the rules below are not consulted at runtime — root
# never needs sudo. They remain installed so an operator who hardens the box by
# running the service as the unprivileged `smartshield` user (e.g.
# `pw useradd -n smartshield` and edit rc.d to `daemon -u smartshield ...`)
# gets least-privilege escalation automatically via priv_helper without code
# changes. Until that hardening is done, the rules sit dormant.
#
# Defense-in-depth architecture
# -----------------------------
# Every entry below mirrors exactly one action template in
# app/services/priv_helper.py. The web app never invokes sudo directly — it
# calls run_privileged("pf.reload", config_path=...) and priv_helper
# applies a per-action Python validator (regex + set membership) BEFORE
# sudo is ever reached. The sudoers wildcards (`*`) below are intentionally
# narrower than priv_helper's validators where the FreeBSD sudo grammar
# allows (e.g. explicit PF table names) and intentionally broader where
# the validator does set-membership checks that sudo's `*` can't express
# (e.g. _KNOWN_SERVICES, _val_iface_name). Read priv_helper.py before
# changing any wildcard here — narrowing one might break a valid action,
# widening one breaks the defense-in-depth.
#
# `smartshieldctl` (bsd/sbin/smartshieldctl) is the OPERATOR console CLI
# for humans on the appliance, NOT the web-app's privileged path, so it
# does NOT appear in this file. Keep it that way: that script intentionally
# exposes `shell` and `factory-reset` verbs that must never be reachable
# by the service user.
#
# SECURITY NOTES
# --------------
# * Do NOT add shell, text editors, or interpreters to this list.
# * Do NOT add wildcards that allow arbitrary file paths outside safe dirs.
# * Do NOT add `smartshieldctl` here.
# * Review this file whenever a new privileged operation is added to the app.
# * Run `visudo -c` after any edit to verify syntax.
# =============================================================================

Defaults:smartshield !requiretty
Defaults:smartshield log_output

# ── PF (packet filter) ───────────────────────────────────────────────────────
# Allow reloading PF from pre-validated config files only
smartshield ALL=(root) NOPASSWD: /sbin/pfctl -f /etc/pf.conf
smartshield ALL=(root) NOPASSWD: /sbin/pfctl -f /etc/pf.captive_portal.conf
