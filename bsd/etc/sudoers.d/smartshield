smartshield ALL=(root) NOPASSWD: /sbin/pfctl -e
smartshield ALL=(root) NOPASSWD: /sbin/pfctl -d
smartshield ALL=(root) NOPASSWD: /sbin/pfctl -F rules
smartshield ALL=(root) NOPASSWD: /sbin/pfctl -a captive_portal -f /etc/pf.captive_portal.conf
