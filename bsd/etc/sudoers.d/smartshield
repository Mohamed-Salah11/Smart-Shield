# ── Kernel modules (priv_helper "kldload") — NARROW allowlist ─────────────────
# priv_helper's validator is broad (_val_safe_pkg_name); sudo can be tighter, so
# only the modules Smart Shield actually loads are permitted here.
smartshield ALL=(root) NOPASSWD: /sbin/kldload netmap
smartshield ALL=(root) NOPASSWD: /sbin/kldload dummynet
smartshield ALL=(root) NOPASSWD: /sbin/kldload carp
